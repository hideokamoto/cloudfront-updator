{
  "name": "cloudfront-updator",
  "version": "3.0.0",
  "description": "Modern CloudFront distribution updator with AWS SDK v3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist && node -e \"require('fs').copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "np"
  },
  "keywords": [
    "aws",
    "cloudfront",
    "aws-sdk-v3",
    "distribution",
    "cdn"
  ],
  "bugs": {
    "url": "https://github.com/hideokamoto/cloudfront-updator/issues"
  },
  "homepage": "https://github.com/hideokamoto/cloudfront-updator#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/cloudfront-updator.git"
  },
  "author": "Hidetaka Okamoto <info@wp-kyoto.net> (https://wp-kyoto.net)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.932.0",
    "deep-object-diff": "^1.1.9",
    "p-limit": "^6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "np": "^12.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tmp": "^0.2.5"
  }
}
